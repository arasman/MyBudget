{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "test": "vitest run",
    "e2e:slides": "playwright test --project=screenshots",
    "slides:index": "node scripts/generate-slide-index.mjs",
    "render-diagrams": "node scripts/render-diagrams.mjs",
    "build-pptx": "node scripts/build-pptx.mjs",
    "export-pptx-pdf": "node scripts/export-pptx-pdf.mjs",
    "build-showcase": "node scripts/build-showcase.mjs",
    "guide:build": "node scripts/build-guide.mjs",
    "guide:check": "node scripts/build-guide.mjs --check"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "axios": "^1.18.1",
    "chart.js": "^4.5.1",
    "daisyui": "^5.6.14",
    "dompurify": "^3.4.11",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.39",
    "vue-chartjs": "^5.3.4",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.13.2",
    "@types/sortablejs": "^1.15.9",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.4",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^29.1.1",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.9.4",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.1",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.5"
  },
  "packageManager": "pnpm@11.3.0"
}
